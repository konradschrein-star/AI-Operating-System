# Server Configuration
PORT=7700
NODE_ENV=production

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/ai_os
HCP_DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/hcp

# Claude Code Engine & Workspaces
CC_BIN=claude
CC_WORKSPACE=/opt/ai-os/workspace
CC_MODEL=claude-3-7-sonnet-20250219
CC_ADD_DIRS=/opt/obsidian-vault
OBSIDIAN_VAULT_DIR=/opt/obsidian-vault
CC_USD_EUR=0.86
RUN_TIMEOUT_MS=600000

# Telegram Bot Bridge
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=123456789

# Legacy Claude Pool API (Optional)
CLAUDE_POOL_URL=http://127.0.0.1:8092
CLAUDE_POOL_API_KEY=your_pool_key

# Concurrency & Schedulers
HEARTBEAT_STUCK_THRESHOLD_MS=90000
CURATOR_TIMEOUT_MS=180000
CRON_TICK_INTERVAL_MS=15000
